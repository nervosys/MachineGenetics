// The lexicon: every token kind the lexer produces, and every reserved
// spelling with the kind it lexes as (NEUROSYMBOLIC_PLAN.md Phase 2).
//
// Generated once from prototype/src/lexer.rs on 2026-10-29; from here on this
// file is the statement and `kb::tests` holds the lexer to it in both
// directions: `TokenKind`'s variants are exactly the `TokenKind` instances,
// and `lexer::KEYWORDS` is exactly the `lexes_as` facts.
//
// Modes are the classes: a `Sigil` is printed in agent mode, the `Keyword` it
// abbreviates in human mode, and a plain `Token` in both. The pairs are what
// `fmt.rs` prints, and a test holds the formatter to them over the corpus.
// `:` abbreviates two keywords, `in` after a `for` pattern and `else` after an
// `if` block; which one is read depends on the grammar, not the spelling.

kb Lexicon {
    // Declaration keywords
    fact instance_of(KwF, TokenKind);
    fact instance_of(KwAf, TokenKind);
    fact instance_of(KwUf, TokenKind);
    fact instance_of(KwM, TokenKind);
    fact instance_of(KwV, TokenKind);
