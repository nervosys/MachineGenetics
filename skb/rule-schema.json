{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Generated by `mage-parse --emit-skb`; mirrors `Rule` in prototype/src/skb.rs.",
  "items": {
    "additionalProperties": false,
    "properties": {
      "category": {
        "type": "string"
      },
      "database": {
        "enum": [
          "Ownership",
          "Borrow",
          "Lifetime",
          "TypeSafety",
          "Concurrency",
          "FFI",
          "AgentElision",
          "SwarmSafety"
        ],
        "type": "string"
      },
      "description": {
        "type": "string"
      },
      "fix_confidence": {
        "maximum": 1.0,
        "minimum": 0.0,
        "type": "number"
      },
      "fix_template": {
        "type": [
          "string",
          "null"
        ]
      },
      "id": {
        "description": "e.g. OWN-0001",
        "type": "string"
      },
      "rationale": {
        "type": "string"
      },
      "severity": {
        "type": "string"
      },
      "tags": {
        "items": {
          "type": "string"
        },
        "type": "array"
      }
    },
    "required": [
      "id",
      "database",
      "category",
      "severity",
      "description",
      "rationale",
      "fix_confidence",
      "tags"
    ],
    "type": "object"
  },
  "title": "MAGE SKB rule",
  "type": "array"
}
